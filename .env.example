# MAIL_FROM=abadaa9518@gmail.com
# MAIL_ADMIN=abadaa9518@gmail.com

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
